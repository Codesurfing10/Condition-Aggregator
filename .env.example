# Condition Aggregator — local/dev environment (copy to .env; never commit secrets)

# Comma-separated browser origins allowed to call the API (must include FRONTEND_ORIGIN)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,https://codesurfing10.github.io

# Public URLs used for Stripe redirects and cookies
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:5500

# Session cookie signing (set a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=ca_session
SESSION_DAYS=14
# COOKIE_SECURE=true          # enable behind HTTPS
# COOKIE_SAMESITE=none        # only if frontend is on another HTTPS origin

# Optional: when set, protected APIs also require header X-API-Key
API_KEY=

# Burst rate limit (requests per minute per client IP) — separate from freemium daily quotas
RATE_LIMIT_PER_MINUTE=60

# Freemium daily quotas (UTC day)
FREE_ROUTES_PER_DAY=3
FREE_CHATS_PER_DAY=1
FREE_SAVED_ROUTES=3
ANON_ROUTES_PER_DAY=3
PRO_ROUTES_PER_DAY=500
PRO_CHATS_PER_DAY=100
PRO_SAVED_ROUTES=100

# SQLite path (default: data/app.db under the repo)
# DATABASE_URL=sqlite:///./data/app.db

# Google Gemini (optional — chat returns 503 if unset)
GEMINI_API_KEY=

# ── Stripe TEST MODE (optional; PayPal preferred — never put live keys here) ─
# Create a Product + recurring Price in Stripe Dashboard (Test mode), copy Price ID.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_ID_PRO=price_xxx
# From `stripe listen --forward-to localhost:8000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Frontend (browser): API base override
# API_BASE=http://127.0.0.1:8000

# ── PayPal SANDBOX (preferred billing; never put live secrets here) ───────────
# Developer Dashboard → Apps & Credentials → Sandbox app → Client ID + Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Leave empty to auto-create a monthly ~$12 USD product+plan on first use; id is written back to .env
PAYPAL_PLAN_ID=
# Optional: webhook id from PayPal Developer → Webhooks (for /api/paypal/webhook verification)
# PAYPAL_WEBHOOK_ID=
# PAYPAL_PRODUCT_NAME=Condition Aggregator Pro
# PAYPAL_PLAN_PRICE_USD=12.00
